{
  "name": "cle-en-main",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @cle/game dev",
    "build": "pnpm --filter @cle/game build",
    "preview": "pnpm --filter @cle/game preview",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @cle/game test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bots": "pnpm --filter @cle/bots start",
    "validate-content": "pnpm --filter @cle/content validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
